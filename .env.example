# Copie para .env.local e preencha. Nunca commite valores reais.
# Lista completa e quando cadastrar cada uma na Vercel: docs/PROGRESS.md#variaveis-de-ambiente

# --- App ---
NEXT_PUBLIC_APP_URL=
# true mostra o botão "Carregar pedidos de exemplo" (apenas para testes)
NEXT_PUBLIC_DEMO_MODE=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://egwxlwtfeswnmpsmphip.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Segurança ---
# 32 bytes em base64: openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -base64 32
CPF_HASH_PEPPER=
# openssl rand -hex 32
CRON_SECRET=

# --- Bling (Fase 1) ---
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# ${NEXT_PUBLIC_APP_URL}/api/integrations/bling/callback
BLING_REDIRECT_URI=

# --- Busca de WhatsApp (Fase 2) ---
# mock | directdata
ENRICHMENT_PROVIDER=mock
DIRECTDATA_TOKEN=

# --- WhatsApp (Fase 3) ---
# mock | meta_cloud | zapi
MESSAGING_PROVIDER=mock
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
